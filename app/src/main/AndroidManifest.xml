<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- "More modules" and the update check read the GitHub API. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Alert when a feature breaks" in Feature health. Asked for only when switched on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- TEMPLATE: lets the app see the hooked package (app info, restart). -->
    <queries>
        <package android:name="com.example.target" />
        <!-- TEMPLATE: for the app picker (#14). Lists launchable apps without QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ModuleApp"
        android:allowBackup="false"
        android:description="@string/app_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:theme="@style/Theme.Module.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- Separate alias so the launcher icon can be hidden without breaking the LSPosed
             settings entry. Name must stay <applicationId>.LauncherAlias (see LauncherIcon.kt). -->
        <activity-alias
            android:name="${applicationId}.LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Keeps the in-app language choice on Android 12 (13+ stores it in the system). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Status reports from the hook inside the target. Exported, but StatusProvider only
             accepts calls from the target app's uid. -->
        <provider
            android:name=".StatusProvider"
            android:authorities="${applicationId}.status"
            android:exported="true" />
    </application>
</manifest>
